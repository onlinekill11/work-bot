BOT_TOKEN=токен_от_BotFather
ADMIN_USERNAME=maximalusdt
# ADMIN_ID можно не заполнять — бот сам запомнит админа при /start
ADMIN_ID=

# Пусто = локальный SQLite (work.db). Для хостинга — строка Neon:
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# max = большее из (процент, фикс); fix = при блоках только фикс
BLOCK_PAY_MODE=max
# смещение часового пояса от UTC (3 = МСК)
TZ_OFFSET=3

# Заполняет хостинг. Локально не нужны:
# PORT=10000            — включает HTTP /health
# KEEPALIVE_URL=...     — самопинг, чтобы Render не усыплял сервис
